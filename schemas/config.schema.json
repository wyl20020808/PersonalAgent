{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "allowedRepositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      }
    },
    "runtimeDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "real"
      ]
    },
    "claudeExecutable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "timeoutMs": {
      "anyOf": [
        {
          "const": 0
        },
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        }
      ],
      "description": "0 disables elapsed-time limits; explicit stop remains available."
    },
    "maxLoops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxReworks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "interaction": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "shell",
                  "browser",
                  "desktop",
                  "system",
                  "resource"
                ]
              },
              "capability": {
                "enum": [
                  "BACKGROUND_SAFE",
                  "DESKTOP_INTERACTIVE",
                  "SYSTEM_HIGH_RISK",
                  "RESOURCE_HEAVY"
                ]
              },
              "headless": {
                "type": "boolean"
              },
              "isolatedBrowser": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "executable",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "mockScenario": {
      "type": "string",
      "enum": [
        "pass",
        "rework",
        "human",
        "fail",
        "timeout",
        "invalid",
        "escape",
        "nochange"
      ]
    },
    "executionMode": {
      "enum": [
        "native",
        "proposal"
      ]
    },
    "claudeStreaming": {
      "type": "boolean"
    },
    "maxClaudeCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "minTasks": {
      "type": "integer",
      "minimum": 1
    },
    "projectMode": {
      "enum": [
        "direct",
        "isolated"
      ]
    },
    "workspaceMode": {
      "enum": [
        "direct",
        "isolated"
      ]
    },
    "directAuthorization": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "acknowledgedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectPath",
        "acknowledgedAt"
      ],
      "additionalProperties": false
    },
    "acceptanceStages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      }
    },
    "globalBudget": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "file",
        "limit"
      ],
      "additionalProperties": false
    },
    "decisionAgent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "codex"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
            },
            "reasoningEffort": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra",
                "persistent"
              ]
            }
          },
          "required": [
            "backend"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "claude-code"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
            },
            "reasoningEffort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "backend"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "opencode"
            },
            "opencode": {
              "type": "object",
              "properties": {
                "providerID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "modelID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "executable": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,100}$"
                }
              },
              "required": [
                "providerID",
                "modelID"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "backend",
            "opencode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "decisionDiscussion": {
      "type": "object",
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "agent": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "backend": {
                        "const": "codex"
                      },
                      "model": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
                      },
                      "reasoningEffort": {
                        "enum": [
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max",
                          "ultra",
                          "persistent"
                        ]
                      }
                    },
                    "required": [
                      "backend"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "backend": {
                        "const": "claude-code"
                      },
                      "model": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
                      },
                      "reasoningEffort": {
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      }
                    },
                    "required": [
                      "backend"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "backend": {
                        "const": "opencode"
                      },
                      "opencode": {
                        "type": "object",
                        "properties": {
                          "providerID": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100000
                          },
                          "modelID": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100000
                          },
                          "executable": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100000
                          },
                          "variant": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9._-]{1,100}$"
                          }
                        },
                        "required": [
                          "providerID",
                          "modelID"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "backend",
                      "opencode"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "agent"
            ],
            "additionalProperties": false
          }
        },
        "primary": {
          "enum": [
            "a",
            "b",
            "c"
          ]
        },
        "rounds": {
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "participants",
        "primary",
        "rounds"
      ],
      "additionalProperties": false
    },
    "executionAgent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "codex"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
            },
            "reasoningEffort": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra",
                "persistent"
              ]
            }
          },
          "required": [
            "backend"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "claude-code"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
            },
            "reasoningEffort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "backend"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "const": "opencode"
            },
            "opencode": {
              "type": "object",
              "properties": {
                "providerID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "modelID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "executable": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,100}$"
                }
              },
              "required": [
                "providerID",
                "modelID"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "backend",
            "opencode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "contextManagement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compactRatio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.95
        },
        "modelWindows": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 10000000
          }
        }
      }
    },
    "transportRetryDelaysMs": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60000
      },
      "description": "Additional retries after provider recovery, default [5000,15000,30000,45000,60000]; [] disables them."
    },
    "taskStages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      }
    }
  },
  "required": [
    "allowedRepositories",
    "runtimeDir",
    "mode",
    "claudeExecutable",
    "timeoutMs",
    "tests",
    "mockScenario"
  ],
  "additionalProperties": false
}