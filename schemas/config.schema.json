{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "allowedRepositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      }
    },
    "runtimeDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "real"
      ]
    },
    "claudeExecutable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 3600000
    },
    "maxLoops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxReworks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        },
        "required": [
          "executable",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "mockScenario": {
      "type": "string",
      "enum": [
        "pass",
        "rework",
        "human",
        "fail",
        "timeout",
        "invalid",
        "escape",
        "nochange"
      ]
    },
    "executionMode": {
      "enum": [
        "native",
        "proposal"
      ]
    },
    "claudeStreaming": {
      "type": "boolean"
    },
    "maxClaudeCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "minTasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "projectMode": {
      "enum": [
        "direct",
        "isolated"
      ]
    },
    "workspaceMode": {
      "enum": [
        "direct",
        "isolated"
      ]
    },
    "directAuthorization": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "acknowledgedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectPath",
        "acknowledgedAt"
      ],
      "additionalProperties": false
    },
    "acceptanceStages": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      }
    },
    "globalBudget": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "file",
        "limit"
      ],
      "additionalProperties": false
    },
    "taskStages": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      }
    }
  },
  "required": [
    "allowedRepositories",
    "runtimeDir",
    "mode",
    "claudeExecutable",
    "timeoutMs",
    "maxLoops",
    "maxReworks",
    "tests",
    "mockScenario"
  ],
  "additionalProperties": false
}