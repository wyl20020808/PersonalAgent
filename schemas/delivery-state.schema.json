{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "digest",
    "phase",
    "approval",
    "written",
    "intent",
    "reason"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "preview",
        "approved",
        "applying",
        "applied",
        "invalidated",
        "blocked"
      ]
    },
    "written": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "decision",
            "time"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}