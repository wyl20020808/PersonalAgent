{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "runId",
    "target",
    "branch",
    "head",
    "baseline",
    "targetStatus",
    "indexHash",
    "workspaceSnapshot",
    "rulesHash",
    "proofHash",
    "diff",
    "changes"
  ],
  "properties": {
    "kind": {
      "const": "direct"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "target": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "targetStatus": {
      "const": ""
    },
    "indexHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspaceSnapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proofHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diff": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content",
          "before",
          "after"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}