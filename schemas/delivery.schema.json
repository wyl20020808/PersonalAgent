{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "changes": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "kind",
        "verificationScope"
      ],
      "properties": {
        "kind": {
          "const": "direct"
        },
        "verificationScope": {
          "const": "未验证全量项目变更：Git Diff 仅含 Git 跟踪内容，包含任务前已有修改；未跟踪、忽略文件及非 Git 文件不提供完整 Diff。Project Context 仅检查文档和 checked_files；不提供全项目备份、恢复或自动 Apply 保证。"
        }
      }
    }
  ],
  "required": [
    "version",
    "id",
    "runId",
    "target",
    "branch",
    "head",
    "baseline",
    "targetStatus",
    "indexHash",
    "workspaceSnapshot",
    "rulesHash",
    "proofHash",
    "diff",
    "changes"
  ],
  "properties": {
    "verificationScope": {
      "type": "string"
    },
    "kind": {
      "const": "direct"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "target": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "targetStatus": {
      "const": ""
    },
    "indexHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspaceSnapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proofHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diff": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content",
          "before",
          "after"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}