{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "rework",
        "human",
        "fail"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    }
  },
  "required": [
    "verdict",
    "reason"
  ],
  "additionalProperties": false
}